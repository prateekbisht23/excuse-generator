{
  "display_information": {
    "name": "Excuse Generator",
    "description": "Sends a funny excuse with your leave and WFH updates, now or on a schedule."
  },
  "oauth_config": {
    "redirect_urls": [
      "https://excuses.bishh.dev/api/connect/slack/callback",
      "https://localhost:3000/api/connect/slack/callback",
      "http://localhost:3000/api/connect/slack/callback"
    ],
    "scopes": {
      "user": [
        "chat:write",
        "channels:read",
        "groups:read",
        "im:write",
        "users:read",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
